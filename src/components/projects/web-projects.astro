---
import ProjectContainer from "./project-container.astro";
import { getTranslations } from "../../i18n";

const t = getTranslations(Astro.currentLocale);

const iconModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/icons/**/*.webp', { eager: true });
const bannerModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/project-banners/web/**/*.webp', { eager: true });

const getIconPath = (path: string) => {
  const fullPath = `../../assets/icons/${path}`;
  return iconModules[fullPath]?.default?.src || '';
};

const getBannerPath = (path: string) => {
  const fullPath = `../../assets/project-banners/web/${path}`;
  return bannerModules[fullPath]?.default?.src || '';
};
---

<ProjectContainer
  imgPath={getBannerPath("crm-application.webp")}
  title={t.projects.web.crm.title}
  imgAlt="Internal CRM Web Application with member management"
  skillIcons={[
    getIconPath("frontend/nextjs-icon.webp"),
    getIconPath("frontend/tanstack-query-icon.webp"),
    getIconPath("backend/postgresql-icon.webp"),
    getIconPath("language/typescript-icon.webp"),
    getIconPath("frontend/tailwind-css-icon.webp"),
  ]}
  skillIconAlts={[
    "nextjs",
    "tanstack",
    "postgresql",
    "typescript",
    "tailwind",
  ]}
  subTitle={t.projects.web.crm.subTitle}
  desc={t.projects.web.crm.desc}
  resourceLink="https://henrychung98.github.io/blog/posts/010-crm-web-app-project/"
  moveLink="https://hc-crm-mvp.vercel.app/"
  accessMethod="website"
/>

<ProjectContainer
  imgPath={getBannerPath("cover-letter-filler-banner.webp")}
  title={t.projects.web.coverLetterFiller.title}
  imgAlt="Cover letter template filler with dynamic placeholder replacement"
  skillIcons={[
    getIconPath("devops/oracle-icon.webp"),
    getIconPath("devops/docker-icon.webp"),
    getIconPath("frontend/nextjs-icon.webp"),
    getIconPath("language/typescript-icon.webp"),
    getIconPath("frontend/tailwind-css-icon.webp"),
  ]}
  skillIconAlts={[
    "Oracle",
    "Docker",
    "Next.js",
    "TypeScript",
    "Tailwind CSS",
  ]}
  subTitle={t.projects.web.coverLetterFiller.subTitle}
  desc={t.projects.web.coverLetterFiller.desc}
  resourceLink="https://henrychung98.github.io/blog/posts/009-cover-letter-filler-project/"
  moveLink="https://cover-letter-filler.vercel.app/"
  accessMethod="website"
/>
<ProjectContainer
  imgPath={getBannerPath("auction-banner.webp")}
  title={t.projects.web.auction.title}
  imgAlt="Competitive bidding platform built for Full-Stack Development course team project"
  skillIcons={[
    getIconPath("frontend/nextjs-icon.webp"),
    getIconPath("backend/mongodb-icon.webp"),
    getIconPath("language/javascript-icon.webp"),
  ]}
  skillIconAlts={[
    "Next.js",
    "MongoDB",
    "JavaScript",
  ]}
  subTitle={t.projects.web.auction.subTitle}
  desc={t.projects.web.auction.desc}
  resourceLink="https://github.com/timdonato/csis3380-final"
  moveLink="https://csis3380-final.netlify.app/"
  accessMethod="website"
  team
/>
