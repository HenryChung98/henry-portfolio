---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";

const languages = [
  { code: "en", label: "EN", href: getRelativeLocaleUrl("en") },
  { code: "ko", label: "한국어", href: getRelativeLocaleUrl("ko") },
];
---

<div class="flex rounded-full border-2 border-primary/50 overflow-hidden text-xs select-none w-fit">
  {languages.map((lang) => (
    <a
      href={lang.href}
      aria-current={locale === lang.code ? "page" : undefined}
      class={`w-14 text-center py-1 transition-colors duration-200 ${
        locale === lang.code
          ? "bg-primary text-primary-foreground pointer-events-none"
          : "text-primary hover:bg-primary/20"
      }`}
    >
      {lang.label}
    </a>
  ))}
</div>
